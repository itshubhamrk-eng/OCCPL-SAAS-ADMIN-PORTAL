# Documentation of /opt/occpl/.env. Do NOT copy this file: bin/init-env.sh writes the real one with
# generated passwords (mode 600). Never commit the real file.
DOMAIN=occplsoftech.com                  # hosts: admin.<DOMAIN>, api.<DOMAIN>, auth.<DOMAIN>
ACME_EMAIL=support@occplsoftech.com         # Let's Encrypt expiry notices
ADMIN_IPS=203.0.113.10/32                # who may open the Keycloak admin console (space-separated)
IMAGE_PREFIX=ghcr.io/itshubhamrk-eng/occpl   # images: <prefix>-core-platform, -admin-portal, -keycloak
RELEASE=<git sha>                        # written by bin/deploy.sh

# Generated by init-env.sh
MYSQL_ROOT_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=
DB_KEYCLOAK_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=                 # user "bootstrap-admin" of the Keycloak master realm
KEYCLOAK_ADMIN_CLIENT_SECRET=
PROVISIONING_CLIENT_SECRET=

# Outgoing email (Core and Keycloak). Port 465 = SMTP_SSL=true; port 587 = SMTP_STARTTLS=true.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@occplsoftech.com
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_FROM_ADDRESS=support@occplsoftech.com  # must be an address the SMTP account may send as
MAIL_FROM=OCCPL Innovations <support@occplsoftech.com>

BOOTSTRAP_SUPER_ADMIN_EMAIL=             # first Super Admin; clear after the first login
PROVISIONING_ALERT_RECIPIENTS=support@occplsoftech.com
RAZORPAY_KEY_ID=                         # empty = billing disabled
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional
# MFA_PLATFORM_REQUIRED=false   dev server only: platform staff may use the portal without an authenticator code. Never on production.
# CORE_MEM_LIMIT=2g  KEYCLOAK_MEM_LIMIT=1536m  MYSQL_MEM_LIMIT=2g  MYSQL_BUFFER_POOL=1G
# BACKUP_S3_URI=s3://occpl-backups-<account>/vps     off-host copy of the backups (see RUNBOOK.md)
# HEARTBEAT_URL=https://hc-ping.com/<uuid>          pinged every 5 minutes while the system is healthy
