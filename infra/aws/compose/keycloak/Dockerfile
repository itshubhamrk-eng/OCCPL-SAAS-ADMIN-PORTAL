# Production Keycloak: optimized build for MySQL with health and metrics, plus the production
# realm import (generated by make-production-realm.py). Build context: this directory.
FROM quay.io/keycloak/keycloak:26.8.1 AS build
ENV KC_DB=mysql \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_CACHE=ispn
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.1
COPY --from=build /opt/keycloak/ /opt/keycloak/
COPY occpl-realm.production.json /opt/keycloak/data/import/occpl-realm.json
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
