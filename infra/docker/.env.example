# Local development only. Copy to infra/docker/.env (gitignored) and change the passwords.
# Never reuse these values in staging or production.
MYSQL_ROOT_PASSWORD=change-me-root
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_PASSWORD=change-me-app
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-core-admin-client
# Verified email that becomes the first SUPER_ADMIN on first login (see DEPLOYMENT.md). Clear after use.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@occpl.local
