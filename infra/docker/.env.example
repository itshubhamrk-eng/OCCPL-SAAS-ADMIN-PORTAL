# Local development only. Copy to infra/docker/.env (gitignored) and change the passwords.
# Never reuse these values in staging or production.
MYSQL_ROOT_PASSWORD=change-me-root
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_APP_PASSWORD=change-me-app
# Read-only backup account (infra/backup).
DB_BACKUP_PASSWORD=change-me-backup
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-core-admin-client
# Verified email that becomes the first SUPER_ADMIN on first login (see DEPLOYMENT.md). Clear after use.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@occpl.local
# Service clients (Phase 7): Core → products, and the sample product → Core.
PROVISIONING_CLIENT_SECRET=change-me-core-services-client
PRODUCT_SAMPLE_CLIENT_SECRET=change-me-sample-client
SAMPLE_DB_MIGRATOR_PASSWORD=change-me-sample-migrator
SAMPLE_DB_APP_PASSWORD=change-me-sample-app
# Receives an email when a provisioning job fails permanently.
PROVISIONING_ALERT_RECIPIENTS=ops@occpl.local
# Billing (Razorpay test mode). Leave empty to keep billing disabled. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
