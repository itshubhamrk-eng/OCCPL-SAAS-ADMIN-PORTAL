{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.occplsoftech.com/schemas/product-config/v1",
  "title": "OCCPL product configuration, schema version 1",
  "description": "Integration settings of a product service. Never put secrets here: service credentials live in Keycloak and the secret store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provisioning"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "launch": {
      "description": "How the portal opens the product for a company.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Path appended to the product's app URL; may contain {companyId} or {companyCode}.",
          "type": "string", "maxLength": 200, "pattern": "^/[A-Za-z0-9/_.{}-]*$"
        },
        "openInNewTab": { "type": "boolean" }
      }
    },
    "provisioning": {
      "description": "How the platform sets up a company in the product (integration contract, ARCHITECTURE.md section 7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["NONE", "SYNC", "ASYNC"] },
        "path": { "type": "string", "maxLength": 200, "pattern": "^/[A-Za-z0-9/_.{}-]*$" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "if": { "properties": { "mode": { "enum": ["SYNC", "ASYNC"] } } },
      "then": { "required": ["path"] }
    },
    "tenantSettings": {
      "description": "Per-company settings the product accepts (definitions only; values are set per company later).",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
          "type": { "enum": ["string", "number", "boolean", "enum"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "required": { "type": "boolean" },
          "default": { "type": ["string", "number", "boolean"] },
          "options": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
        }
      }
    },
    "metadata": {
      "description": "Free-form, non-secret labels.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$" },
      "additionalProperties": { "type": "string", "maxLength": 500 }
    }
  }
}
